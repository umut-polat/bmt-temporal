# Copy to secrets.env (gitignored) and fill in.
# Loaded by worker and CLI at startup.

# --- SSH ---
# Per-host password (only for machines whose `auth` is "password" in machines.json).
# The variable name is `SSH_PASSWORD_<NAME>` where <NAME> is the machine name
# upper-cased with non-alphanumeric characters replaced by `_`.
# Example: a machine named "host-a" expects SSH_PASSWORD_HOST_A.
# SSH_PASSWORD_HOST_A=change-me

# Path to the SSH private key used by machines whose `auth` is "ssh_key".
SSH_KEY_PATH=~/.ssh/id_rsa

# Sudo password used on every host (apt install, dmidecode, raw-disk fio).
SUDO_PASSWORD=change-me

# --- Temporal ---
# Defaults match docker-compose.yml. Override only if running against a remote cluster.
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=openstack-test
TEMPORAL_TASK_QUEUE=bare-metal-tests

# --- PostgreSQL (results store, separate from Temporal's own DB) ---
# Defaults match docker-compose.yml. Override if running against a different instance.
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=bare_metal_tests
